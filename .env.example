# ============================================================
# keepbreath.ing — contact API secrets (.env.example)
# ============================================================
# Copy this to `.env` (gitignored) and fill in the real values. Docker Compose reads
# `.env` automatically for ${VAR} substitution in docker-compose.yml, and routes each
# value to only the service that needs it (least privilege).

# Password for the Redis broker (the queue). Generate a long random one:
#   openssl rand -hex 32
REDIS_PASSWORD=

# ALTCHA HMAC key — signs the proof-of-work challenges. Long random secret; keep it
# stable or in-flight challenges break. Used only by the web service.
ALTCHA_HMAC_KEY=

# SMTP submission credential — the contact@ send-as login (from the lockbox).
# Used only by the worker service (the web app never sends mail, so never sees these).
CONTACT_SMTP_USER=contact@keepbreath.ing
CONTACT_SMTP_PASS=
