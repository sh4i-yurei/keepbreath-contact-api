# ============================================================
# keepbreath.ing — contact API env template (contact-api.env.example)
# Author: Mark Thompson
# ============================================================
# Copy this to `contact-api.env` ON THE DROPLET and fill in the real values.
# contact-api.env is gitignored and injected via compose `env_file` — NEVER
# commit it. This .example (no secrets) IS committed, as documentation.

# SMTP submission credential — the contact@ send-as login (from the lockbox)
CONTACT_SMTP_USER=contact@keepbreath.ing
CONTACT_SMTP_PASS=

# ALTCHA HMAC key — signs the proof-of-work challenges. Use a long random secret
# (e.g. `openssl rand -hex 32`). Keep it stable, or in-flight challenges break.
ALTCHA_HMAC_KEY=

# Where the SQLite replay DB lives INSIDE the container — points at the mounted
# volume (see docker-compose.yml) so the used-token history survives restarts.
REPLAY_DB_PATH=/data/altcha_replay.db
